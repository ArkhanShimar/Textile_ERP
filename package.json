{
  "name": "textile-erp-desktop",
  "version": "1.0.0",
  "description": "Textile ERP Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:client && npm run build:server && electron-builder",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start": "electron ."
  },
  "keywords": ["erp", "textile", "desktop", "electron"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-is-dev": "^2.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.textile.erp",
    "productName": "Textile ERP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/dist/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
