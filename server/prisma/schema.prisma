generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE_STAFF
}

enum OrderStatus {
  PENDING
  APPROVED
  ESTIMATED
  CONFIRMED
  PRINTED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PRINTED
  PAID
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  RESERVED
  RELEASED
  ADJUSTMENT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  email     String?  @unique
  role      Role     @default(OFFICE_STAFF)
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  createdPurchaseOrders  PurchaseOrder[] @relation("CreatedBy")
  updatedPurchaseOrders  PurchaseOrder[] @relation("UpdatedBy")
  createdInvoices        Invoice[]        @relation("InvoiceCreatedBy")
  createdDeliveryOrders  DeliveryOrder[]  @relation("DOCreatedBy")
  activityLogs           ActivityLog[]

  @@index([username])
}

model Store {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  address     String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  inventory   Inventory[]
  deliveryOrders DeliveryOrder[]

  @@index([code])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  categoryId  String
  storeId     String
  size        String?
  color       String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category        @relation(fields: [categoryId], references: [id])
  store       Store           @relation(fields: [storeId], references: [id])
  inventory   Inventory?
  purchaseOrderItems PurchaseOrderItem[]
  deliveryOrderItems  DeliveryOrderItem[]
  invoiceItems        InvoiceItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([code])
  @@index([categoryId])
  @@index([storeId])
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  availableQuantity Int      @default(0)
  reservedQuantity  Int      @default(0)
  totalQuantity     Int      @default(0)
  lowStockThreshold Int      @default(10)
  storeId           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product           Product  @relation(fields: [productId], references: [id])
  store             Store    @relation(fields: [storeId], references: [id])
  transactions      InventoryTransaction[]

  @@index([productId])
  @@index([storeId])
}

model InventoryTransaction {
  id          String           @id @default(uuid())
  inventoryId String
  productId  String
  quantity    Int
  type        TransactionType
  reference   String?
  notes       String?
  createdAt   DateTime         @default(now())
  createdBy   String?

  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@index([inventoryId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  gstin       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([phone])
}

model PurchaseOrder {
  id              String      @id @default(uuid())
  poNumber        String      @unique
  customerId      String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  tax             Decimal     @db.Decimal(12, 2) @default(0)
  discount        Decimal     @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal     @db.Decimal(12, 2)
  notes           String?
  deliveryAddress String?
  estimatedAmount Decimal?    @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?
  updatedBy       String?
  approvedAt      DateTime?
  approvedBy      String?
  estimatedAt     DateTime?
  estimatedBy     String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?

  customer        Customer            @relation(fields: [customerId], references: [id])
  items           PurchaseOrderItem[]
  deliveryOrders  DeliveryOrder[]
  invoices        Invoice[]
  creator         User?               @relation("CreatedBy", fields: [createdBy], references: [id])
  updater         User?               @relation("UpdatedBy", fields: [updatedBy], references: [id])

  @@index([poNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  totalPrice      Decimal @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model DeliveryOrder {
  id              String          @id @default(uuid())
  doNumber        String          @unique
  purchaseOrderId String
  storeId         String
  status          DeliveryStatus  @default(PENDING)
  dispatchDate    DateTime?
  deliveryDate    DateTime?
  dispatchedBy    String?
  receivedBy      String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?

  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  store           Store           @relation(fields: [storeId], references: [id])
  items           DeliveryOrderItem[]
  creator         User?           @relation("DOCreatedBy", fields: [createdBy], references: [id])

  @@index([doNumber])
  @@index([purchaseOrderId])
  @@index([storeId])
  @@index([status])
}

model DeliveryOrderItem {
  id             String         @id @default(uuid())
  deliveryOrderId String
  productId      String
  quantity       Int
  unitPrice      Decimal        @db.Decimal(10, 2)
  totalPrice     Decimal        @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deliveryOrder  DeliveryOrder  @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([deliveryOrderId])
  @@index([productId])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  purchaseOrderId String        @unique
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @db.Decimal(12, 2)
  tax             Decimal       @db.Decimal(12, 2) @default(0)
  discount        Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @db.Decimal(12, 2) @default(0)
  dueDate         DateTime?
  paidDate        DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  items           InvoiceItem[]
  creator         User?         @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])

  @@index([invoiceNumber])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoiceId  String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
}
